<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="16dp">
	<TextView
		android:id="@+id/export_dir_title"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:textAppearance="?android:attr/textAppearanceSmall"
		android:textColor="?android:attr/textColorSecondary"
		android:text="@string/export_directory"/>
	<LinearLayout
		android:id="@+id/export_dir_row"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:background="?android:attr/selectableItemBackground"
		android:clickable="true"
		android:focusable="true"
		android:paddingTop="8dp"
		android:paddingBottom="8dp">
		<ImageView
			android:id="@+id/export_dir_icon"
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:src="@drawable/ic_action_folder"
			app:tint="?attr/colorPrimary"/>
		<TextView
			android:id="@+id/export_dir_value"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginStart="16dp"
			android:maxLines="1"
			android:ellipsize="middle"
			android:textAppearance="?android:attr/textAppearanceMedium"
			android:textColor="?android:attr/textColorPrimary"/>
		<ImageView
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:src="@drawable/ic_action_edit"
			android:contentDescription="@string/change_export_directory"
			app:tint="?android:attr/textColorSecondary"/>
	</LinearLayout>
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:gravity="end"
		android:orientation="horizontal">
		<TextView
			android:id="@+id/export_multiselect_toggle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:background="?android:attr/selectableItemBackground"
			android:clickable="true"
			android:focusable="true"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:paddingTop="8dp"
			android:paddingBottom="8dp"
			android:text="@string/multiselect"
			android:textColor="?attr/colorPrimary"
			android:textAppearance="?android:attr/textAppearanceMedium"/>
	</LinearLayout>
	<LinearLayout
		android:id="@+id/export_selection_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:visibility="gone">
		<TextView
			android:id="@+id/export_select_all"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:background="?android:attr/selectableItemBackground"
			android:clickable="true"
			android:focusable="true"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:paddingTop="8dp"
			android:paddingBottom="8dp"
			android:text="@string/select_all"
			android:textColor="?attr/colorPrimary"
			android:textAppearance="?android:attr/textAppearanceMedium"/>
		<TextView
			android:id="@+id/export_selection_count"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:gravity="center"
			android:textAppearance="?android:attr/textAppearanceSmall"
			android:textColor="?android:attr/textColorSecondary"/>
		<TextView
			android:id="@+id/export_delete_selected"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:background="?android:attr/selectableItemBackground"
			android:clickable="true"
			android:focusable="true"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:paddingTop="8dp"
			android:paddingBottom="8dp"
			android:text="@string/delete_selected"
			android:textColor="?attr/colorPrimary"
			android:textAppearance="?android:attr/textAppearanceMedium"/>
	</LinearLayout>
	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/exports_list"
		android:layout_width="match_parent"
		android:layout_height="360dp"
		android:layout_marginTop="8dp"
		android:scrollbars="vertical"/>
	<TextView
		style="@style/SecondaryText"
		android:id="@+id/exports_hint"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:text="@string/archive_list_hint"/>
</LinearLayout>
